<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-8">
    <br />
    <h3>Create a new listing</h3>
    <form action="/listing" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="title" class="form-label">Enter your property title:</label>
        <input
          type="text"
          name="listing[title]"
          class="form-control"
          placeholder="Add a catchy title"
          required
        />
        <div class="invalid-feedback">Are you stupid or acting like one?</div>
        <div class="valid-feedback">Looks good man !</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Enter description:</label>
        <textarea
          name="listing[description]"
          class="form-control"
          placeholder="Add details..."
          required
        ></textarea>
        <div class="invalid-feedback">Man just enter anything nobody minds</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Enter your price:</label>
          <input
            type="number"
            name="listing[price]" 
            class="form-control"
            placeholder="in rupees"
            required
          />
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Enter your country:</label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            placeholder="India, China, Pak"
            required
          />
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Enter your location:</label>
        <input
          type="text"
          name="listing[location]"
          class="form-control"
          placeholder="Jaipur, Rajisthan, jalander"
          required
        />
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Enter your image url: </label>
        <!-- <input type="text" name="image[filename]" placeholder="listingimage"> -->
        <input
          type="text"
          name="listing[image[url]]"
          placeholder="url"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-dark add-btn">Submit</button>
      <br /><br />
    </form>
  </div>
</div>

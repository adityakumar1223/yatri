<%- layout("./layouts/boilerplate.ejs") %>

<div class="row-mt-3">

    <div class="col-6 offset-3">
        <h1 class="col-6 offset-3">Login to Yatri</h1>
        <form action="/user/login" method="POST" novalidate class="needs-validation">
            <div>
                <label for="username">Enter username</label>
                <input type="text" name="username" placeholder="example@123" required class="form-control">
                <div class="invalid-feedback">This spcae can't be empty</div>
                <div class="valid-feedback">Looks good !</div>
            </div>
            <div>
                <label for="password">Enter password</label>
                <input type="password" id="password" name="password" placeholder="********" required class="form-control">
                <div class="invalid-feedback">This spcae can't be empty</div>
                <div class="valid-feedback">Looks good !</div>
            </div>
            <div class="mt-3">
                <button class="btn btn-dark">Login</button>
            </div>
        </form>
    </div>

</div>
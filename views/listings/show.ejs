<% layout("/layouts/boilerplate") %>

<script>
const mapToken = "<%= process.env.MAP_TOKEN %>";
  window.property =  <%- JSON.stringify(property) %>;
</script>

<div class="row justify-content-center padman">
  <div class="col-12 col-md-8">
    <h3 class="mb-4"><%= property.title %></h3>

    <div class="listing-card shadow-sm">
      <!-- Listing Image -->
      <img
        src="<%= property.image.url %>"
        class="card-img-top"
        alt="<%= property.title %>"
        style="height: 350px; object-fit: cover"
      />

      <div class="card-body">
        <!-- Title -->
        <!-- <h4 class="card-title mb-3"></h4> -->

        <!-- Description -->
        <label for="owner">Listed by:</label> <i><%= property.owner.username %></i>
        <p class="card-text"><%= property.description %></p>

        <hr />

        <!-- Listing Information -->
        <div class="mb-3">
          <p class="mb-2">
            <strong>Price:</strong>
            ₹<%= property.price.toLocaleString("en-IN") %>
          </p>

          <p class="mb-2">
            <strong>Location:</strong>
            <%= property.location %>
          </p>

          <p class="mb-2">
            <strong>Country:</strong>
            <%= property.country %>
          </p>
        </div>

        <!-- Buttons -->
         <% if (currUser && currUser._id.equals(property.owner._id) ) {%>
        <div class="d-flex gap-2 mt-4">
          <form action="/listing/<%= property.id %>/edit">
            <button class="btn add-btn">Edit Listing</button>
          </form>

          <form
            action="/listing/<%= property.id %>/delete?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-outline-danger">Delete Listing</button>
          </form>
        </div>

        <% }%>
      </div>
    </div>
  </div>

  <hr />
  <% if(currUser) { %> 
  <div class="col-12 col-md-8">
    <h4>Leave a review</h4>
    <form action="/listing/<%= property.id %>/reviews?_method=POST" novalidate class="needs-validation" method="post">

<!-- review Starts -->
  <div class="mt-3 mb-3"> 
    <label for="rating" class="form-label">Rating</label>   
  <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
  </fieldset>

    </div>
      <div class="mt-3 mb-3">
        <label for="Comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          rows="5"
          cols="30"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Enter something dude you cant leave it like this</div>
        <div class="valid-feedback">Everything looks fine</div> 
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr>
    <%}%>

    <!--show Review Section  -->

    <% if (property.reviews.length > 0) { %>
    <div class="row col-12 col-md-8">
      <h4 class="mb-2 mt-2">All reviews</h4>
    <% for(review of property.reviews) { %>
    <div class="card col-5 ms-3 mb-3">
      <div class="card-body ">
        <h5 class="card-title"><%= review.owner.username %></h5>
        <p class="card-text"><%=review.comment %></p>
          <p class="starability-result card-text" data-rating="<%=review.rating %>">
    Rated: 3 stars
    </p>
        <p class="card-text"><%=review.createdAt.toDateString() %></p>
        <% if( currUser && review.owner._id.equals(currUser._id)) {%>
        <form  class="mb-3" action="/listing/<%=property._id %>/reviews/<%=review._id%>?_method=DELETE" method="POST">
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
        <% } %>
      </div>
    </div>
    <% } %>
    </div>

    <hr>
    <% } %>
    
    
  </div>
  
  <div class="col-12 col-md-8">
    <h3>Where you will be</h3>
  <div id="map" ></div>
  
  </div>
  
</div>

<script src="/js/map.js"></script>

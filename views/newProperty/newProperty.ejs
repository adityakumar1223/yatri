<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-8 ">
    <br>
    <h3>Create a new listing</h3>
    <form action="/listing" method="POST">
      <div class="mb-3">
        <label for="title" class="form-label">Enter your property title:</label>
        <input type="text" name="title" class="form-control" placeholder="Add a catchy title" />
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Enter description:</label>
        <textarea
          name="description"
          class="form-control"
          placeholder="Add details..."
        ></textarea>
      </div>

      <div class="row">
        
      <div class="mb-3 col-md-4" >
        <label for="price" class="form-label">Enter your price:</label>
        <input type="number" name="price" class="form-control" placeholder="in rupees" />
      </div>

      
      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Enter your country:</label>
        <input type="text" name="country" class="form-control" placeholder="India, China, Pak" />
      </div>


      </div>
      
      <div class="mb-3">
        <label for="location" class="form-label">Enter your location:</label>
        <input type="text" name="location" class="form-control" placeholder="Jaipur, Rajisthan, jalander" />
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Enter your image url: </label>
        <!-- <input type="text" name="image[filename]" placeholder="listingimage"> -->
        <input
          type="text"
          name="image[url]"
          placeholder="url"
          class="form-control"
        />
      </div>
      <button class="btn btn-dark add-btn">Submit</button>
      <br><br>
    </form>
  </div>
</div>

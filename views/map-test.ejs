
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Mapbox Test</title>

  <link
    href="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.css"
    rel="stylesheet"
  />

  <style>
    body {
      margin: 20px;
      font-family: Arial, sans-serif;
    }

    #map {
      width: 100%;
      height: 450px;
      background: #eee;
    }
  </style>
</head>
<body>
  <h2>Mapbox Test</h2>
  <div id="map"></div>

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.js"></script>

  <script>
    const token = <%- JSON.stringify(mapToken) %>;

    console.log("Mapbox library:", typeof mapboxgl);
    console.log("Public token available:", Boolean(token));

    mapboxgl.accessToken = token;

    const map = new mapboxgl.Map({
      container: "map",
      center: [77.2090, 28.6139],
      zoom: 9,
      style: "mapbox://styles/mapbox/streets-v12"
    });

    map.on("load", () => {
      console.log("Map loaded successfully");
    });

    map.on("error", (event) => {
      console.error("Mapbox map error:", event.error);
    });
  </script>
</body>
</html>

<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center padman">
  <div class="col-12 col-md-8">
    <h3 class="mb-4"><%= property.title %></h3>

    <div class="listing-card shadow-sm">
      <!-- Listing Image -->
      <img
        src="<%= property.image.url %>"
        class="card-img-top"
        alt="<%= property.title %>"
        style="height: 350px; object-fit: cover"
      />

      <div class="card-body">
        <!-- Title -->
        <!-- <h4 class="card-title mb-3"></h4> -->

        <!-- Description -->
        <p class="card-text"><%= property.description %></p>

        <hr />

        <!-- Listing Information -->
        <div class="mb-3">
          <p class="mb-2">
            <strong>Price:</strong>
            ₹<%= property.price.toLocaleString("en-IN") %>
          </p>

          <p class="mb-2">
            <strong>Location:</strong>
            <%= property.location %>
          </p>

          <p class="mb-2">
            <strong>Country:</strong>
            <%= property.country %>
          </p>
        </div>

        <!-- Buttons -->
        <div class="d-flex gap-2 mt-4">
          <form action="/listing/<%= property.id %>/edit">
            <button class="btn add-btn">Edit Listing</button>
          </form>

          <form
            action="/listing/<%= property.id %>/delete?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-outline-danger">Delete Listing</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <hr />
  <div class="col-12 col-md-8">
    <h4>Leave a review</h4>
    <form action="/listing/<%= property.id %>/reviews?_method=POST" novalidate class="needs-validation" method="post">
      <div class="mt-3 mb-3">
        <label for="rating" class="form-label">Rating</label>
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
          required
        />
      </div>
      <div class="mt-3 mb-3">
        <label for="Comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          rows="5"
          cols="30"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Enter something dude you cant leave it like this</div>
        <div class="valid-feedback">Everything looks fine</div> 
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr>

    <p><b>All reviews</b></p>
    <div class="row">
    <% for(review of property.reviews) { %>
    <div class="card col-5 ms-3 mb-3">
      <div class="card-body ">
        <h5 class="card-title">Aditya Kumar</h5>
        <p class="card-text"><%=review.comment %></p>
        <p class="card-text"><%=review.rating %>&#9733;</p>
        <p class="card-text"><%=review.createdAt.toDateString() %></p>
        <form  class="mb-3" action="/listing/<%=property._id %>/reviews/<%=review._id%>?_method=DELETE" method="POST">
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
      </div>
    </div>
    <% } %>
    </div>
    
  </div>
</div>
